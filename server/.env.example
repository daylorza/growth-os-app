# Copy to .env for local runs. On a server these live only in root-owned systemd units, never in git.
GROWTH_OS_HOST=127.0.0.1
GROWTH_OS_PORT=8767
GROWTH_OS_MONGO_URL=mongodb://127.0.0.1:27017
GROWTH_OS_MONGO_DB=growth_os

# Creator login (HTTP Basic, the dashboard). Use a long generated password.
GROWTH_OS_USER=
GROWTH_OS_PASS=

# One bearer key per role (16+ characters, all different). A write to another role's collection is a 403.
GROWTH_OS_ANALYST_KEY=
GROWTH_OS_CREATIVE_KEY=
GROWTH_OS_CREATOR_KEY=
# Scheduler key: can only call /api/dispatch/*.
GROWTH_OS_WORKER_KEY=
# Names recorded as the author of each write (e.g. your agents' names).
GROWTH_OS_ANALYST_NAME=analyst
GROWTH_OS_CREATIVE_NAME=creative

# Where each agent is woken up. Leave empty for an agent that reads the API instead.
ANALYST_WEBHOOK_URL=
ANALYST_WEBHOOK_KEY=
CREATIVE_WEBHOOK_URL=
CREATIVE_WEBHOOK_KEY=
# Base delay for webhook retries (3 retries, x4 backoff).
WEBHOOK_RETRY_BASE_MS=1000
