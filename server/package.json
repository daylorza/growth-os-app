{
  "name": "growth-os-server",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/main.js",
    "test": "vitest run",
    "lint": "oxlint src test scripts",
    "migrate": "node scripts/migrate.mts",
    "worker:dispatch": "node dist/worker/dispatch-worker.js",
    "worker:xai-fallback": "node dist/worker/xai-fallback.js"
  },
  "dependencies": {
    "@growth-os/contracts": "workspace:^",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/mapped-types": "12.0.0",
    "@nestjs/platform-express": "12.3.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "mongodb": "7.7.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "oxlint": "1.90.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "1.6.0",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.18"
  }
}
