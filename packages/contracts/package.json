{
  "name": "@growth-os/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared DTOs, domain types and the OpenAPI spec for the Growth OS API. Source of truth for field names.",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json && node dist/scripts/gen-openapi.js --check",
    "openapi": "tsc -p tsconfig.json && node dist/scripts/gen-openapi.js",
    "lint": "oxlint src scripts test",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/mapped-types": "12.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "class-validator-jsonschema": "5.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@swc/core": "1.16.20",
    "@types/node": "24.19.2",
    "oxlint": "1.90.0",
    "typescript": "6.0.3",
    "unplugin-swc": "1.6.0",
    "vitest": "4.1.12"
  }
}
