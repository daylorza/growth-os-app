# Copy to .env.local (gitignored).
# Endpoint mode: the NestJS API base URL. Leave empty for local mode (browser localStorage only).
GROWTH_OS_API=
# Connector server for OAuth "Connect" buttons. Leave empty for export-file connectors only.
NEXT_PUBLIC_CONNECTOR_SERVER=
# Set to 1 to preview the public sample workspace even when ../private exists.
GROWTH_OS_IGNORE_PRIVATE=
# Private workspace folder. Defaults to ../private.
GROWTH_OS_PRIVATE_DIR=
